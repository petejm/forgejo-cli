# Local config — contains pointers to secrets, never commit
*.local.md

# Secrets
.env
*.pem
*.key
credentials*
*_credentials*

# Editor and OS artifacts
.DS_Store
*.swp
*.swo
*~

# Python bytecode from tests/checks/ — tests/lint.sh sets
# PYTHONDONTWRITEBYTECODE=1, but running a check script directly still emits it
__pycache__/
*.pyc
